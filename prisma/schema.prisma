generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") 
}

// 1. SuperAdmin
model SuperAdmin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  email     String   @unique
  role      String   @default("superadmin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 2. Admin (School Account)
model Admin {
  id                   Int       @id @default(autoincrement())
  username             String    @unique
  password             String
  name                 String
  schoolName           String
  schoolCode           String?   @unique
  studentLimit         Int       @default(0)
  currentStudentCount  Int       @default(0)
  expiryDate           DateTime
  isActive             Boolean   @default(true)
  deactivatedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // ✅ ADDED: Store allowed features as a JSON object for role-based access
  allowedFeatures      Json?

  // Relations
  students              Student[]
  teachers              Teacher[]
  classes               Class[]
  subjects              Subject[]
  sessions              Session[]
  terms                 Term[]
  tests                 Test[]
  questions             Question[]
  questionSets          QuestionSet[]
  submissions           StudentSubmission[]
  attendances           Attendance[]
  continuousAssessments ContinuousAssessment[]
  gradingSystems        GradingSystem[]
  classTeacherComments  ClassTeacherComment[]
  teacherComments       TeacherComment[]
  principalComments     PrincipalComment[]
  resultAccessSchedules ResultAccessSchedule[]
  schoolOpenDays        SchoolOpenDays[]
  siteInformation       SiteInformation?
  teacherAssignments    TeacherAssignment[]
  
  // ✅ ADDED RELATION
  resultPins            ResultPin[]
  networkSettings Json? // ✅ Stores { ip: "...", port: "..." }
}

// ✅ NEW: Admin Registration Tokens (Generated by SuperAdmin)
model AdminToken {
  id           Int       @id @default(autoincrement())
  token        String    @unique
  schoolName   String?   // Optional: SuperAdmin can pre-assign a school name
  studentLimit Int       @default(0)
  expiryDate   DateTime? // Account expiry date set by SuperAdmin
  isUsed       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  // ✅ ADDED: Store allowed features temporarily in the token
  allowedFeatures Json?
}

// 3. SiteInformation
model SiteInformation {
  id                  Int      @id @default(autoincrement())
  adminId             Int      @unique
  admin               Admin    @relation(fields: [adminId], references: [id])
  schoolName          String   @default("")
  shortName           String   @default("")
  schoolMotto         String   @default("")
  address             String   @default("")
  state               String   @default("")
  country             String   @default("Nigeria")
  phoneNumber         String   @default("")
  email               String   @default("")
  website             String   @default("")
  registrationNumber  String   @default("")
  principalName       String   @default("")
  schoolLogo          Json?
  principalSignature  Json?
  schoolStamp         Json?
  admissionPrefix     String   @default("SCH")
  admissionCounter    Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// 4. Subject
model Subject {
  id         Int      @id @default(autoincrement())
  adminId    Int
  admin      Admin    @relation(fields: [adminId], references: [id])
  name       String
  code       String
  classLevel String?
  description String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([adminId, code])
  @@index([adminId])
}

// 5. Teacher
model Teacher {
  id            Int      @id @default(autoincrement())
  adminId       Int
  admin         Admin    @relation(fields: [adminId], references: [id])
  firstName     String
  lastName      String
  email         String
  username      String
  password      String
  phone         String?
  address       String?
  qualification String?
  experience    Int      @default(0)
  subjects      Int[]    // Array of Subject IDs
  lastLogin     DateTime?
  lastLoginIP   String   @default("")
  lastLoginDevice String  @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ✅ ADDED RELATION
  eNoteWeeks    ENoteWeek[]

  @@unique([adminId, email])
  @@unique([adminId, username])
  @@index([adminId])
}

// 6. Class
model Class {
  id                  Int      @id @default(autoincrement())
  adminId             Int
  admin               Admin    @relation(fields: [adminId], references: [id])
  name                String
  level               String
  section             String
  session             String
  teacherId           Int
  capacity            Int
  subjects            Int[]    // Array of Subject IDs
  students            Int[]    // Array of Student IDs
  isActive            Boolean  @default(true)
  
  resultAccessBlocked Boolean  @default(false)
  resultBlockReason   String   @default("")
  resultBlockedAt     DateTime?
  resultBlockedBy     Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // ✅ ADDED RELATION
  eNoteWeeks          ENoteWeek[]

  @@unique([adminId, name, level, section, session])
  @@index([adminId])
}

// 7. Student
model Student {
  id                  Int      @id @default(autoincrement())
  adminId             Int
  admin               Admin    @relation(fields: [adminId], references: [id])
  firstName           String
  lastName            String
  admissionNumber     String?
  classId             Int?
  gender              String?
  owingFees           Boolean  @default(false)
  feesAccessGranted   Boolean  @default(false)
  isDeleted           Boolean  @default(false)
  
  profileImage        Json?
  
  resultAccessBlocked Boolean  @default(false)
  resultBlockReason   String   @default("")
  resultBlockedAt     DateTime?
  resultBlockedBy     Int?
  
  testResults         Json?    // Array of test result objects
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // ✅ ADDED RELATION
  resultPins          ResultPin[]

  @@unique([adminId, admissionNumber])
  @@index([adminId])
}

// 8. Session
model Session {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id])
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, name])
  @@index([adminId])
}

// 9. Term
model Term {
  id             Int      @id @default(autoincrement())
  adminId        Int
  admin          Admin    @relation(fields: [adminId], references: [id])
  name           String
  sessionId      Int
  startDate      DateTime
  endDate        DateTime
  nextTermBegins DateTime?
  status         String   @default("upcoming")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([adminId, name, sessionId])
  @@index([adminId])
}

// 10. Test
model Test {
  id              Int      @id @default(autoincrement())
  adminId         Int
  admin           Admin    @relation(fields: [adminId], references: [id])
  title           String
  classId         Int
  subjectId       Int
  duration        Int
  startDate       DateTime
  endDate         DateTime
  passMark        Int
  instructions    String?
  questions       Json     // Array of question objects
  createdById     Int
  isActive        Boolean  @default(true)
  resultsPublished Boolean @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([adminId, classId, subjectId])
  @@index([adminId])
}

// 11. Question
model Question {
  id            Int      @id @default(autoincrement())
  adminId       Int
  admin         Admin    @relation(fields: [adminId], references: [id])
  classId       Int
  subjectId     Int
  questionText  String
  options       String[] // Array of strings
  correctAnswer Int
  difficulty    String   @default("medium")
  explanation   String?
  teacherId     Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([adminId, classId, subjectId])
  @@index([adminId])
}

// 12. QuestionSet
model QuestionSet {
  id         Int      @id @default(autoincrement())
  adminId    Int
  admin      Admin    @relation(fields: [adminId], references: [id])
  title      String
  classId    Int
  subjectId  Int
  teacherId  Int
  questions  Json     // Array of question objects
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([adminId, title])
  @@index([adminId, classId, subjectId])
  @@index([adminId])
}

// 13. StudentSubmission
model StudentSubmission {
  id            Int      @id @default(autoincrement())
  adminId       Int
  admin         Admin    @relation(fields: [adminId], references: [id])
  classId       Int
  subjectId     Int
  questionText  String
  options       String[]
  correctAnswer Int
  explanation   String?
  studentId     Int
  status        String   @default("pending")
  isActive      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([adminId, classId, studentId])
  @@index([adminId])
}

// 14. Attendance
model Attendance {
  id           Int      @id @default(autoincrement())
  adminId      Int
  admin        Admin    @relation(fields: [adminId], references: [id])
  studentId    Int
  classId      Int
  term         String
  session      String
  timesPresent Int      @default(0)
  teacherId    Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([adminId, studentId, classId, term, session])
  @@index([adminId])
}

// 15. ContinuousAssessment
model ContinuousAssessment {
  id               Int      @id @default(autoincrement())
  adminId          Int
  admin            Admin    @relation(fields: [adminId], references: [id])
  studentId        Int
  classId          Int
  subjectId       Int
  termId           Int
  sessionId        Int
  teacherId        Int
  
  testScore        Int      @default(0)
  noteTakingScore  Int      @default(0)
  assignmentScore  Int      @default(0)
  totalCA          Int      @default(0)
  
  examScore        Int      @default(0)
  totalScore       Int      @default(0)
  
  grade            String   @default("")
  remark           String   @default("")
  
  sourceTestId     Int?
  status           String   @default("draft")
  approvedBy       Int?
  approvedAt       DateTime?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([adminId, studentId, classId, subjectId, termId, sessionId])
  @@index([adminId])
}

// 16. GradingSystem
model GradingSystem {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id])
  name      String
  grades    Json     // Array of grade objects
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, name])
  @@index([adminId])
}

// 17. ClassTeacherComment
model ClassTeacherComment {
  id         Int      @id @default(autoincrement())
  adminId    Int
  admin      Admin    @relation(fields: [adminId], references: [id])
  studentId  Int
  classId    Int
  teacherId  Int
  comment    String
  term       String
  session    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([adminId, studentId, classId, term, session])
  @@index([adminId])
}

// 18. TeacherComment
model TeacherComment {
  id             Int      @id @default(autoincrement())
  adminId        Int
  admin          Admin    @relation(fields: [adminId], references: [id])
  studentId      Int
  classId        Int
  subjectId      Int
  teacherId      Int
  termId         Int
  sessionId      Int
  comment        String
  effortRating   String   @default("")
  behaviourRating String  @default("")
  status         String   @default("draft")
  submittedAt    DateTime?
  approvedBy     Int?
  approvedAt     DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([adminId, studentId, classId, subjectId, termId, sessionId])
  @@index([adminId])
}

// 19. PrincipalComment
model PrincipalComment {
  id                  Int      @id @default(autoincrement())
  adminId             Int
  admin               Admin    @relation(fields: [adminId], references: [id])
  studentId           Int
  termId              Int
  sessionId           Int
  classId             Int?
  comment             String
  percentage          Int      @default(0)
  classTeacherComment String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([adminId, studentId, termId, sessionId])
  @@index([adminId])
}

// 20. ResultAccessSchedule
model ResultAccessSchedule {
  id              Int      @id @default(autoincrement())
  adminId         Int
  admin           Admin    @relation(fields: [adminId], references: [id])
  termId          Int
  sessionId       Int
  resultStartTime DateTime
  resultDeadline  DateTime
  message         String   @default("Results are not available at this time. Please check back later.")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([adminId, termId, sessionId])
  @@index([adminId])
}

// 21. SchoolOpenDays
model SchoolOpenDays {
  id         Int      @id @default(autoincrement())
  adminId    Int
  admin      Admin    @relation(fields: [adminId], references: [id])
  termId     Int
  sessionId  Int
  timesOpen  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([adminId, termId, sessionId])
  @@index([adminId])
}

// 22. TeacherAssignment
model TeacherAssignment {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id])
  teacherId Int
  classId   Int
  subjectId Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, teacherId, classId, subjectId])
  @@index([adminId])
}

// 23. E-Notes Models
model ENoteWeek {
  id        Int      @id @default(autoincrement())
  title     String   // e.g., "WEEK 1", "MID TERM BREAK"
  classId   Int
  teacherId Int?     // Optional, tracks who created it (if a teacher did)
  adminId   Int      // For tenant filtering (school isolation)
  
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  files     ENoteFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId, teacherId])
}

model ENoteFile {
  id          Int      @id @default(autoincrement())
  fileName    String
  fileUrl     String
  weekId      Int
  subjectId   Int?     // Links to the Subject table
  subjectName String?  // Stored string of the subject name for easy display

  week        ENoteWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weekId])
}

// 24. Result PINs Model
model ResultPin {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id])
  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id])
  
  pin       String   @unique
  termId    Int
  sessionId Int
  
  // ✅ ADDED HERE
  usageCount Int     @default(0)
  
  isUsed    Boolean  @default(false)
  usedAt    DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId, termId, sessionId])
}